<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>ProjeYonetimi</RootNamespace>
    <AssemblyName>ProjeYonetimi</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Product>Proje Yönetimi</Product>
    <Description>SQL Server tabanlı proje, görev ve çalışan yönetimi uygulaması</Description>
    <Authors>Umut Karahasan</Authors>
    <Version>2.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Arayüz kütüphanesi: NuGet'ten otomatik indirilir -->
    <PackageReference Include="ReaLTaiizor" Version="3.7.8.5" />
    <!-- .NET Framework derlemesi için referans paketleri (Visual Studio dışı derleme) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Forms\AnaForm.cs" SubType="Form" />
    <Compile Update="Forms\GirisForm.cs" SubType="Form" />
    <Compile Update="Forms\AnaForm.Gelistirmeler.cs" DependentUpon="AnaForm.cs" />
  </ItemGroup>

</Project>
